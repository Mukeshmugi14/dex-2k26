PORT=5000
CLIENT_URL=http://localhost:5173
MONGO_URI=
# Long random value (at least 32 characters). Admin login is refused with a weak or placeholder value.
JWT_SECRET=
# Evaluator Portal sessions and one-time codes (at least 32 random characters). Optional when JWT_SECRET is
# already 32+ characters; set it to enable the portal without changing JWT_SECRET (which signs teams out).
EVALUATOR_JWT_SECRET=
# Signs Round 1 PDF submission links. Keep it set to the value used when the links were emailed.
SUBMISSION_LINK_SECRET=
EMAIL_USER=
EMAIL_PASSWORD=
# On hosts that block SMTP (Render's free plan blocks ports 25/465/587), send email through Brevo's HTTPS API:
# create a free Brevo account, verify EMAIL_USER (or BREVO_SENDER_EMAIL) as a sender, and set the API key here.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# First admin only (created when no admin exists): the chief head's Gmail. Its password is then set on the
# admin login page with "Get a code" (a 4-digit code emailed through EMAIL_USER). Leave ADMIN_PASSWORD empty.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Round 2 prototype close (29 Oct 2026, 11:59 PM IST). Leave unset to use the published time.
ROUND2_DEADLINE=2026-10-29T23:59:59.999+05:30
ROUND2_EDIT_DEADLINE=2026-10-29T23:59:59.999+05:30

# Public site used in email links (defaults to https://sist-website-frontend.vercel.app; never localhost)
SITE_URL=https://sist-website-frontend.vercel.app
